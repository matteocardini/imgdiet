{
  "name": "imgdiet",
  "version": "0.1.0",
  "description": "Find out how much weight a website's images could lose. Point it at a URL or a folder and see oversized, uncompressed and outdated-format images, with an estimate of what you would save.",
  "license": "MIT",
  "author": "Matteo Cardini",
  "homepage": "https://github.com/matteocardini/imgdiet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matteocardini/imgdiet.git"
  },
  "bugs": "https://github.com/matteocardini/imgdiet/issues",
  "type": "module",
  "bin": {
    "imgdiet": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "images",
    "performance",
    "webp",
    "avif",
    "cli",
    "audit",
    "page-weight",
    "core-web-vitals"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
